{
  "name": "iom-regatta-manager",
  "version": "1.0.0",
  "description": "IOM Regatta Manager: scoring and running IOM radio-sailing regattas (SHRS heat racing)",
  "keywords": [
    "sailing",
    "regatta",
    "scoring",
    "iom",
    "shrs",
    "electron"
  ],
  "homepage": "https://github.com/Cufta123/ScoringAppNewVersion#readme",
  "bugs": {
    "url": "https://github.com/Cufta123/ScoringAppNewVersion/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cufta123/ScoringAppNewVersion.git"
  },
  "license": "MIT",
  "author": {
    "name": "Antonio Luksic"
  },
  "main": "./out/main/main.js",
  "scripts": {
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "prepare": "husky",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "package": "npm run build && electron-builder build --win --x64",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "start": "electron-vite dev --watch",
    "test": "jest --config jest.unit.config.ts --no-coverage",
    "test:unit": "jest --config jest.unit.config.ts --no-coverage",
    "test:full": "jest",
    "test:e2e": "playwright test",
    "test:smoke": "npm run build && playwright test"
  },
  "browserslist": [
    "extends browserslist-config-erb"
  ],
  "prettier": {
    "singleQuote": true,
    "overrides": [
      {
        "files": [
          ".prettierrc",
          ".eslintrc"
        ],
        "options": {
          "parser": "json"
        }
      }
    ]
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --fix",
    "*.{json,css,scss,md}": "prettier --write"
  },
  "jest": {
    "moduleDirectories": [
      "node_modules",
      "release/app/node_modules",
      "src"
    ],
    "moduleFileExtensions": [
      "js",
      "jsx",
      "ts",
      "tsx",
      "json"
    ],
    "moduleNameMapper": {
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/src/__tests__/helpers/fileMock.js",
      "\\.(css|less|sass|scss)$": "identity-obj-proxy",
      "^regatta-core$": "<rootDir>/packages/regatta-core/src/index.ts",
      "^regatta-core/(.*)$": "<rootDir>/packages/regatta-core/$1"
    },
    "setupFiles": [
      "./scripts/check-build-exists.ts"
    ],
    "testEnvironment": "jsdom",
    "testEnvironmentOptions": {
      "url": "http://localhost/"
    },
    "testPathIgnorePatterns": [
      "release/app/dist",
      "<rootDir>/e2e/",
      "<rootDir>/src/__tests__/fixtures/",
      "<rootDir>/src/__tests__/helpers/",
      "<rootDir>/.claude/",
      "<rootDir>/report-worker/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.claude/"
    ],
    "transform": {
      "\\.(ts|tsx|js|jsx)$": "ts-jest"
    }
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^9.0.9"
    }
  },
  "dependencies": {
    "@electron/notarize": "^2.3.2",
    "@fortawesome/fontawesome-free": "^6.6.0",
    "@tanstack/react-query": "^5.106.1",
    "electron-debug": "^3.2.0",
    "exceljs": "^4.4.0",
    "papaparse": "^5.5.3",
    "react": "^18.2.0",
    "react-autosuggest": "^10.1.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.16.0",
    "react-select": "^5.8.1",
    "react-toastify": "^10.0.5",
    "react-world-flags": "^1.6.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@playwright/test": "^1.61.0",
    "@testing-library/jest-dom": "^6.1.3",
    "@testing-library/react": "^14.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.2.21",
    "@types/react-autosuggest": "^10.1.11",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^6.7.0",
    "@typescript-eslint/parser": "^6.7.0",
    "@vitejs/plugin-react": "^5.2.0",
    "browserslist-config-erb": "^0.0.3",
    "electron": "^42.4.0",
    "electron-builder": "^26.8.1",
    "electron-devtools-installer": "^4.0.0",
    "electron-vite": "^6.0.0",
    "eslint": "^8.49.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-erb": "^4.1.0-0",
    "eslint-import-resolver-typescript": "^3.6.0",
    "eslint-plugin-compat": "^4.2.0",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-jest": "^27.4.0",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "lint-staged": "^17.0.7",
    "prettier": "^3.0.3",
    "ts-jest": "^29.1.1",
    "ts-json-schema-generator": "^2.9.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2",
    "vite": "^8.3.5"
  },
  "build": {
    "productName": "IOM Regatta Manager",
    "appId": "com.cufta123.iomregattamanager",
    "asar": true,
    "asarUnpack": "**/*.{node,dll}",
    "files": [
      "dist",
      "node_modules",
      "package.json"
    ],
    "mac": {
      "sign": "scripts/notarize.js",
      "notarize": false,
      "target": {
        "target": "default",
        "arch": [
          "arm64",
          "x64"
        ]
      },
      "type": "distribution",
      "hardenedRuntime": true,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "gatekeeperAssess": false
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "directories": {
      "app": "release/app",
      "buildResources": "assets",
      "output": "release/build"
    },
    "extraResources": [
      "./assets/**",
      "./demo_table.db"
    ],
    "publish": {
      "provider": "github",
      "owner": "electron-react-boilerplate",
      "repo": "electron-react-boilerplate"
    }
  },
  "collective": {
    "url": "https://opencollective.com/electron-react-boilerplate-594"
  },
  "engines": {
    "node": ">=14.x",
    "npm": ">=7.x"
  }
}
