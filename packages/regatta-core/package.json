{
  "name": "regatta-core",
  "version": "0.1.0",
  "private": true,
  "description": "SHRS 2026-1 heat racing: a log of decisions in, heats, scores and standings out. No database, no UI.",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "regatta-core": "dist/cli.js"
  },
  "files": [
    "dist",
    "schema"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "schema": "ts-node scripts/schema.ts",
    "examples": "ts-node scripts/examples.ts",
    "results": "ts-node src/cli.ts",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.0",
    "jest": "^30.0.0",
    "ts-jest": "^29.1.1",
    "ts-json-schema-generator": "^2.9.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  },
  "prettier": {
    "singleQuote": true
  }
}
