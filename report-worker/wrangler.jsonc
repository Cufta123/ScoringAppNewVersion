{
  // IOM Regatta Manager report service: e-mails problem reports sent from
  // the app. Secrets (wrangler secret put): APP_KEY, RESEND_API_KEY, TO_ADDRESS.
  "name": "iom-report",
  "main": "src/index.js",
  "compatibility_date": "2026-10-23",
  "observability": { "enabled": true },
  "vars": {
    "FROM_ADDRESS": "IOM Regatta Manager <onboarding@resend.dev>"
  },
  // At most 5 reports a minute from one address: enough for a race office,
  // too few to flood the inbox.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ]
}
