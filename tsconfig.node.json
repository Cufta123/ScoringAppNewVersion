{
  // The build config (electron.vite.config.ts) runs in Node through
  // electron-vite, whose types need the bundler resolution; the app's
  // tsconfig.json keeps its own settings and leaves this file out.
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["electron.vite.config.ts"]
}
